{
  "name": "campusswap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker start campusswap-oracle || docker run -d --name campusswap-oracle -p 1521:1521 -e ORACLE_PASSWORD=campusswap123 -e APP_USER=campus -e APP_USER_PASSWORD=campus123 gvenzl/oracle-free:23-slim-faststart",
    "db:down": "docker stop campusswap-oracle",
    "db:reset": "docker cp db/schema.sql campusswap-oracle:/tmp/schema.sql && docker exec -i campusswap-oracle sqlplus -S campus/campus123@//localhost:1521/FREEPDB1 @/tmp/schema.sql",
    "db:seed": "tsx db/seed.ts",
    "db:setup": "npm run db:reset && npm run db:seed",
    "db:cli": "docker exec -it campusswap-oracle sqlplus campus/campus123@//localhost:1521/FREEPDB1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.18.2",
    "jose": "^5.9.6",
    "next": "15.0.3",
    "oracledb": "^6.10.0",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/oracledb": "^6.10.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.0.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
