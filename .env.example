# ----------------------------------------------------------------------
# Lokal geliştirme — SQLite (default)
# ----------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ----------------------------------------------------------------------
# Production — PostgreSQL (Neon / Vercel Postgres / Supabase)
# Provider'i prisma/schema.prisma içinde "postgresql" olarak değiştir.
# ----------------------------------------------------------------------
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# JWT imzalama anahtarı. `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"` ile üret.
JWT_SECRET="degisik-bir-cok-uzun-rastgele-string-buraya"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
