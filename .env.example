# PostgreSQL connection string
# Vercel Postgres / Neon / Supabase ile uyumlu
DATABASE_URL="postgresql://user:password@host:5432/campusswap?sslmode=require"

# Direct (non-pooled) URL — Prisma migrate için. Neon/Vercel için zorunlu.
DIRECT_URL="postgresql://user:password@host:5432/campusswap?sslmode=require"

# JWT imzalama anahtarı (en az 32 karakter). openssl rand -base64 32 ile üret.
JWT_SECRET="degisik-bir-cok-uzun-rastgele-string-buraya"

# Public site URL (Vercel'de otomatik set edilir)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
