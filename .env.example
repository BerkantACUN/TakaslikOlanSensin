# ----------------------------------------------------------------------
# Supabase / PostgreSQL bağlantısı
# ----------------------------------------------------------------------
# Supabase Dashboard > Project Settings > Database > Connection string > URI
# Vercel deploy için "Transaction" pooler önerilir (port 6543):
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# Lokal dev için direkt connection (port 5432) da kullanılabilir.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Connection pool boyutu (opsiyonel)
PG_POOL_MAX="10"

# JWT imzalama anahtarı. Üret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="degisik-bir-cok-uzun-rastgele-string-buraya"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
